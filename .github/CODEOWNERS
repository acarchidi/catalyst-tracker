# Owner-owned paths. GitHub enforces this file only with a ruleset, which needs a paid
# plan for a private repository; on the free plan it only requests the owner as a
# reviewer, and the merge robot does not wait for it (ADR 0006, ADR 0007).

# Data that cannot be changed back easily
/pipeline/migrations/          @acarchidi
/pipeline/catalyst/db/         @acarchidi
/alembic.ini                   @acarchidi

# What may publish, who may see it, and what it costs (paths reserved for later phases)
/pipeline/catalyst/verification/  @acarchidi
/pipeline/catalyst/publish/       @acarchidi
/pipeline/catalyst/auth/          @acarchidi
/pipeline/catalyst/billing/       @acarchidi
/config/models.toml            @acarchidi
/pipeline/catalyst/llm/        @acarchidi
/pipeline/catalyst/settings.py @acarchidi

# The rules, the gates, and the review itself
AGENTS.md                      @acarchidi
CLAUDE.md                      @acarchidi
/.claude/                      @acarchidi
/docs/spec.md                  @acarchidi
/docs/quality-gates.md         @acarchidi
/.github/                      @acarchidi
/scripts/review_verdict.py     @acarchidi
/.gitleaks.toml                @acarchidi
/.pre-commit-config.yaml       @acarchidi

# Dependencies and tool settings
/pyproject.toml                @acarchidi
/uv.lock                       @acarchidi
